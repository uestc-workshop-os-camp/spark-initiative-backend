[Unit]
Description=Spark Initiative repository creation service
Documentation=https://github.com/uestc-workshop-os-camp/spark-initiative-backend
Wants=network-online.target
After=network-online.target mariadb.service
ConditionPathExists=/etc/spark-initiative-backend/env
ConditionPathExists=/etc/spark-initiative-backend/github-app.pem

[Service]
Type=simple
User=spark-backend
Group=spark-backend
WorkingDirectory=/var/lib/spark-initiative-backend
EnvironmentFile=/etc/spark-initiative-backend/env
Environment=GOMEMLIMIT=128MiB
ExecStart=/opt/spark-initiative-backend/current/spark-initiative-backend
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/spark-initiative-backend

TasksMax=64
LimitNOFILE=4096
MemoryHigh=128M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
