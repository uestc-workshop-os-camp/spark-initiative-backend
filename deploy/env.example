SPARK_LISTEN_ADDR=127.0.0.1:8081
SPARK_PUBLIC_URL=https://csinfra.cn
SPARK_MYSQL_DSN=spark_claim:replace-me@tcp(127.0.0.1:3306)/os_camp?charset=utf8mb4&timeout=5s&readTimeout=10s&writeTimeout=10s
SPARK_COOKIE_KEY_BASE64=replace-me

SPARK_GITHUB_ORG=uestc-workshop-os-camp
SPARK_GITHUB_CLIENT_ID=replace-me
SPARK_GITHUB_CLIENT_SECRET=replace-me
SPARK_GITHUB_INSTALLATION_ID=replace-me
SPARK_GITHUB_PRIVATE_KEY_FILE=/etc/spark-initiative-backend/github-app.pem

SPARK_RUST_ENABLED=false
SPARK_RCORE_ENABLED=false
SPARK_RUST_TEMPLATE=uestc-workshop-os-camp/rustling-2026-template
SPARK_RCORE_TEMPLATE=uestc-workshop-os-camp/rCore-Camp-Code-2026
